#Область СлужебныеПроцедурыИФункции

// Вернуть остаток на кошельке.
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Вернуть остаток на кошельке:
//		*СуммаОстаток - Число
Функция ВернутьОстатокНаКошельке()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(ОстаткиДенегОстатки.СуммаОстаток, 0) КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиДенег.Остатки(&МоментВремени, Кошелек = &КошелекОтправитель) КАК ОстаткиДенегОстатки";
	
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	Запрос.УстановитьПараметр("КошелекОтправитель", КошелекОтправитель);
	
	Выборка = Запрос.Выполнить().Выбрать();

	Возврат Выборка;

КонецФункции

#КонецОбласти

