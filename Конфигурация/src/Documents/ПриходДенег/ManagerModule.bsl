#Область СлужебныеПроцедурыИФункции

// Вернуть выборку.
// 
// Параметры:
//  Ссылка - Произвольный - Ссылка
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Вернуть выборку:
//		*Номер - Строка
//		*Дата - Дата
//		*Кошелек - СправочникСсылка.Кошельки
//		*ТабличнаяЧасть - ДокументТабличнаяЧасть.ПриходДенег.ТабличнаяЧасть:
//			*НомерСтроки - Число
//			*СтатьяДвижения - СправочникСсылка.ДвиженияДенег
//			*Сумма - Число
Функция ВернутьВыборку(Ссылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПриходДенег.Номер КАК Номер,
		|	ПриходДенег.Дата КАК Дата,
		|	ПриходДенег.Кошелек КАК Кошелек,
		|	ПриходДенег.ТабличнаяЧасть.(
		|		НомерСтроки КАК НомерСтроки,
		|		СтатьяДвижения КАК СтатьяДвижения,
		|		Сумма КАК Сумма) КАК ТабличнаяЧасть
		|ИЗ
		|	Документ.ПриходДенег КАК ПриходДенег
		|ГДЕ
		|	ПриходДенег.Ссылка В (&Ссылка)";
		
	Запрос.Параметры.Вставить("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка;
	
КонецФункции

#КонецОбласти

#КонецЕсли
