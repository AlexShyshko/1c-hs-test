Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.РезервыДенег.Записывать = Истина;
	Движения.РезервыДенег.Очистить();
	
	Для Каждого ТекСтрока Из ТабличнаяЧасть Цикл
		
		ДвижениеРезервыДенег = Движения.РезервыДенег.ДобавитьПриход();
