		ДвижениеРезервыДенег.СтатьяДвижения = ТекСтрока.СтатьяДвижения;
		ДвижениеРезервыДенег.Месяц = НачалоМесяца(Месяц);
		ДвижениеРезервыДенег.Сумма = ТекСтрока.Сумма;
		
	КонецЦикла;

КонецПроцедуры

